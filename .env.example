# ── Copy to .env and fill in. Everything is OPTIONAL. ─────────────────────────
# With no keys, the app runs 100% in FALLBACK mode (canned/simulated outputs),
# so you can rehearse offline. Add keys to switch each demo to LIVE.
# Per-call, if a live call fails, the app degrades to fallback automatically.

# ── Foundry resource (MAI-Thinking-1 + MAI-Image-2.5) ─────────────────────────
# Endpoint looks like: https://<your-resource>.services.ai.azure.com
MAI_FOUNDRY_ENDPOINT=
MAI_FOUNDRY_API_KEY=

# Deployment names you assigned in Foundry (defaults shown).
# Edit and generation defaults shown below. Check the current model catalog before
# deploying; these values are deployment names and remain configurable.
MAI_THINKING_DEPLOYMENT=MAI-Thinking-1
MAI_IMAGE_EDIT_DEPLOYMENT=MAI-Image-2.5
MAI_IMAGE_GEN_DEPLOYMENT=MAI-Image-2.5-Flash

# Optional: a SEPARATE resource for image models. Needed when your Foundry/chat
# resource is in a region without MAI image models (e.g. East US 2). Point these at
# a Foundry resource in a SUPPORTED region (East US, West US, West Central US, West
# Europe, Sweden Central, South India, UAE North). If image is on the SAME resource
# as chat, set these to the same values as MAI_FOUNDRY_*. Blank => Image in fallback.
MAI_IMAGE_ENDPOINT=
MAI_IMAGE_API_KEY=

# ── Speech resource (MAI-Transcribe-1.5 + MAI-Voice-2) ────────────────────────
# Transcribe endpoint: https://<your-speech-resource>.cognitiveservices.azure.com
MAI_SPEECH_ENDPOINT=
MAI_SPEECH_KEY=
# Region used for the TTS host: <region>.tts.speech.microsoft.com
MAI_SPEECH_REGION=eastus

# Advanced (rarely need to change)
MAI_TRANSCRIBE_MODEL=mai-transcribe-1.5
MAI_TRANSCRIBE_API_VERSION=2025-10-15

# ── Execution mode ────────────────────────────────────────────────────────────
# "demo" (default): a failed live call degrades to a labelled FALLBACK so an
#   on-stage demo never dies mid-sentence.
# "strict": live failures raise instead of degrading — use it for pre-flight
#   checks and CI so a broken endpoint actually fails:
#     MAI_EXECUTION_MODE=strict python scripts/live_smoke.py
MAI_EXECUTION_MODE=demo

# Optional per-service connect/read timeout overrides (seconds). Reasoning can
# legitimately take more than 90s, so its read budget is deliberately generous.
# MAI_THINKING_CONNECT_TIMEOUT=10
# MAI_THINKING_READ_TIMEOUT=300
# MAI_IMAGE_CONNECT_TIMEOUT=10
# MAI_IMAGE_READ_TIMEOUT=180
# MAI_TRANSCRIBE_CONNECT_TIMEOUT=10
# MAI_TRANSCRIBE_READ_TIMEOUT=180
# MAI_VOICE_CONNECT_TIMEOUT=10
# MAI_VOICE_READ_TIMEOUT=90
